<?xml version="1.0" encoding="utf-8"?>
<!-- 信号强度 4 级：4 格全亮（满格）。API 19 兼容：用 inset 控制 layer bounds。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="0dp" android:top="3dp" android:right="12dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <size android:width="3dp" android:height="4dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="2dp" android:right="8dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <size android:width="3dp" android:height="5dp" />
        </shape>
    </item>
    <item android:left="8dp" android:top="1dp" android:right="4dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <size android:width="3dp" android:height="6dp" />
        </shape>
    </item>
    <item android:left="12dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <size android:width="3dp" android:height="7dp" />
        </shape>
    </item>
</layer-list>