<?xml version="1.0" encoding="utf-8"?>
<!-- 虚拟 OK 确认键背景（API 19 兼容，支持按压态） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#141820" />
            <stroke android:width="1.5dp" android:color="#60a5fa" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3a4556"
                android:endColor="#202732" />
            <stroke android:width="1.5dp" android:color="#526074" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
