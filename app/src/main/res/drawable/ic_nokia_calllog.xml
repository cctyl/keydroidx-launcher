<?xml version="1.0" encoding="utf-8"?>
<!-- 通话记录图标：上下两条横线。API 19 兼容：inset 控制 layer bounds。整体 20×20dp。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 上线 20×2，距顶 4dp -->
    <item android:left="0dp" android:top="4dp" android:right="0dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#2196F3" />
        </shape>
    </item>
    <!-- 下线 20×2，距底 4dp -->
    <item android:left="0dp" android:top="14dp" android:right="0dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#2196F3" />
        </shape>
    </item>
</layer-list>