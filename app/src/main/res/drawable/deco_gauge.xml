<?xml version="1.0" encoding="utf-8"?>
<!-- 仪表盘装饰。API 19 兼容：用 inset 控制 layer bounds（不用 android:width/height）。整体 50×50dp。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 内圆 40×40 居中 -->
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#555555" />
        </shape>
    </item>
    <!-- 外环 50×50 -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="#64b5f6" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>