<?xml version="1.0" encoding="utf-8"?>
<!-- 联系人图标。API 19 兼容：inset 控制 layer bounds。整体 24×22dp。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景 24×22 -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#2196F3" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- 头部 8×8，距顶 3dp -->
    <item android:left="8dp" android:top="3dp" android:right="8dp" android:bottom="11dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- 肩部 16×8，距底 2dp -->
    <item android:left="4dp" android:top="12dp" android:right="4dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp" />
        </shape>
    </item>
</layer-list>