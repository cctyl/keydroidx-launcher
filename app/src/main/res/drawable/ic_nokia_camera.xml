<?xml version="1.0" encoding="utf-8"?>
<!-- 相机图标。API 19 兼容：inset 控制 layer bounds。整体 26×20dp，闪光灯溢出顶部 4dp。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顶部闪光灯 8×4，水平居中 -->
    <item android:left="9dp" android:top="-4dp" android:right="9dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#1976D2" />
            <corners
                android:topLeftRadius="2dp"
                android:topRightRadius="2dp" />
        </shape>
    </item>
    <!-- 机身 26×20 -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#2196F3" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <!-- 镜头 10×10 居中 -->
    <item android:left="8dp" android:top="5dp" android:right="8dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#0d1b3e" />
            <stroke
                android:width="2dp"
                android:color="#64b5f6" />
        </shape>
    </item>
</layer-list>