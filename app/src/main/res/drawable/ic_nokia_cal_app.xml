<?xml version="1.0" encoding="utf-8"?>
<!-- 日历应用图标。API 19 兼容：inset 控制 layer bounds。整体 22×20dp，挂环溢出顶部 3dp。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主体 22×20 -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#F44336" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- 左上挂环 4×4 -->
    <item android:left="4dp" android:top="-3dp" android:right="14dp" android:bottom="19dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- 右上挂环 4×4 -->
    <item android:left="14dp" android:top="-3dp" android:right="4dp" android:bottom="19dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>