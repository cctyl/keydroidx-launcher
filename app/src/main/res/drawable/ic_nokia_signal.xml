<?xml version="1.0" encoding="utf-8"?>
<!-- 旧版信号图标（3 根白条，底部对齐）。API 19 兼容：inset 控制 layer bounds。整体 8×8dp。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 条1 2×4，底部对齐 -->
    <item android:left="0dp" android:top="4dp" android:right="6dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- 条2 2×6，x=3..5 -->
    <item android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- 条3 2×8，x=6..8 -->
    <item android:left="6dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>