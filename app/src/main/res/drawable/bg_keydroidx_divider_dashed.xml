<?xml version="1.0" encoding="utf-8"?>
<!-- 横向点线（虚线）分割线 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="line">
    <stroke
        android:width="1dp"
        android:color="#60FFFFFF"
        android:dashWidth="3dp"
        android:dashGap="3dp" />
</shape>
