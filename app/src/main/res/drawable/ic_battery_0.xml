<?xml version="1.0" encoding="utf-8"?>
<!-- 电量 0-10%：第 1 格红色。
     API 19 兼容：用 inset 控制每个 layer 的绘制区域 = 图层期望大小 (15×9 外框 / 2×5 格 / 3×5 帽)，
     shape 在区域内填充。layer-list intrinsic 大小 = max(inset 累计) = 18×9dp。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 电池外框 15×9 at (0,0): L=0, T=0, R=3, B=0 -->
    <item android:left="0dp" android:top="0dp" android:right="3dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#FFFFFF"/>
            <corners android:radius="1dp"/>
            <solid android:color="#00000000"/>
            <size android:width="15dp" android:height="9dp"/>
        </shape>
    </item>
    <!-- 第 1 格 2×5 at (2,2): L=2, T=2, R=14, B=2 -->
    <item android:left="2dp" android:top="2dp" android:right="14dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#F44336"/>
            <size android:width="2dp" android:height="5dp"/>
        </shape>
    </item>
    <!-- 电池帽 3×5 at (15,2): L=15, T=2, R=0, B=2 -->
    <item android:left="15dp" android:top="2dp" android:right="0dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="1dp"/>
            <size android:width="3dp" android:height="5dp"/>
        </shape>
    </item>
</layer-list>