<?xml version="1.0" encoding="utf-8"?>
<!-- 对讲机图标：左右两条圆角竖杠。API 19 兼容：inset 控制 layer bounds。整体 9×16dp。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 左条 7×16，距左 2dp -->
    <item android:left="2dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#2196F3" />
            <corners
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp"
                android:topLeftRadius="2dp"
                android:topRightRadius="2dp" />
        </shape>
    </item>
    <!-- 右条 7×16，距右 2dp -->
    <item android:left="0dp" android:top="0dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#2196F3" />
            <corners
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp"
                android:topLeftRadius="2dp"
                android:topRightRadius="2dp" />
        </shape>
    </item>
</layer-list>