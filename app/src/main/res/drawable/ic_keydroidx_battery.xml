<?xml version="1.0" encoding="utf-8"?>
<!-- 启动占位电池（满电 4 格，与 ic_battery_100 风格一致）。API 19 兼容：inset 控制 layer bounds。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="0dp" android:top="0dp" android:right="3dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#FFFFFF"/>
            <corners android:radius="1dp"/>
            <solid android:color="#00000000"/>
            <size android:width="15dp" android:height="9dp"/>
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="14dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#4CAF50"/>
            <size android:width="2dp" android:height="5dp"/>
        </shape>
    </item>
    <item android:left="5dp" android:top="2dp" android:right="11dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#4CAF50"/>
            <size android:width="2dp" android:height="5dp"/>
        </shape>
    </item>
    <item android:left="8dp" android:top="2dp" android:right="8dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#4CAF50"/>
            <size android:width="2dp" android:height="5dp"/>
        </shape>
    </item>
    <item android:left="11dp" android:top="2dp" android:right="5dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#4CAF50"/>
            <size android:width="2dp" android:height="5dp"/>
        </shape>
    </item>
    <item android:left="15dp" android:top="2dp" android:right="0dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="1dp"/>
            <size android:width="3dp" android:height="5dp"/>
        </shape>
    </item>
</layer-list>