<?xml version="1.0" encoding="utf-8"?>
<!-- 虚拟挂机键背景（经典微红强调，API 19 兼容） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#7f1d1d" />
            <stroke android:width="1.5dp" android:color="#f87171" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3d1f22"
                android:endColor="#261214" />
            <stroke android:width="1dp" android:color="#782d33" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
