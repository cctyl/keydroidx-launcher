<?xml version="1.0" encoding="utf-8"?>
<!-- 日历小图标。API 19 兼容：inset 控制 layer bounds。整体 14×12dp。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主体 14×12 -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <!-- 左上挂环 3×3 -->
    <item android:left="3dp" android:top="-2dp" android:right="8dp" android:bottom="11dp">
        <shape android:shape="rectangle">
            <solid android:color="#F44336" />
        </shape>
    </item>
    <!-- 右上挂环 3×3 -->
    <item android:left="8dp" android:top="-2dp" android:right="3dp" android:bottom="11dp">
        <shape android:shape="rectangle">
            <solid android:color="#F44336" />
        </shape>
    </item>
</layer-list>