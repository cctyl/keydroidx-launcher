<?xml version="1.0" encoding="utf-8"?>
<!-- mini_shizuku 服务页面：240dp 宽，match_parent 高自适应中间容器 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_nokia_menu">

    <!-- 状态行 -->
    <TextView
        android:id="@+id/shizukuStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="状态检测中..."
        android:textColor="#9fb3d1"
        android:textSize="11sp" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2a4a7a" />

    <!-- 可滚动内容区：激活方式菜单 -->
    <ScrollView
        android:id="@+id/shizukuScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <!-- 菜单项由代码动态构建（adb 激活 / root 激活） -->
            <LinearLayout
                android:id="@+id/shizukuActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2a4a7a" />
</LinearLayout>
