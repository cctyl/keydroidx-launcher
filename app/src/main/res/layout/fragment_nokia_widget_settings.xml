<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面组件设置：S1~S5 全部状态共用的内容区。
     顶部副标题（已选 X/15 / 删除模式 / 排序模式）+ 组件列表。
     选项菜单（S2）与删除子菜单（S3）为底部弹出的 DialogFragment（样式与 JAR 选项菜单一致）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <TextView
        android:id="@+id/tvWidgetStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:text="已选 0 / 15 项"
        android:textColor="#64b5f6"
        android:textSize="10sp" />

    <ScrollView
        android:id="@+id/widgetScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/widgetListLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp" />
    </ScrollView>
</LinearLayout>
