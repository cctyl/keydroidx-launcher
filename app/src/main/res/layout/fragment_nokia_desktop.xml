<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面待机屏中间内容（碎片）：240dp 宽，高度 match_parent 自适应中间容器。
     顶栏与快捷栏（含上下点线）位置固定优先保障；通知/组件区填充剩余空间，
     允许被挤压（后续会做可滚动）。基类缩放不再触发二次缩小分支。
     运营商名(中国移动/联通等)已迁到 nokia_top_bar.xml，由 StatusBarController 统一管理。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 快捷栏上方的点线分割线（代码覆盖背景为 NokiaDashedLineDrawable 点阵） -->
    <View
        android:id="@+id/shortcutDividerTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp" />

    <HorizontalScrollView
        android:id="@+id/shortcutBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/shortcutDividerTop"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/shortcutContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

    <!-- 选中快捷应用时，在图标正上方浮出的名称气泡 -->
    <TextView
        android:id="@+id/shortcutNameBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="0dp"
        android:background="@drawable/bg_nokia_bubble"
        android:gravity="center"
        android:maxWidth="200dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- 快捷栏与通知区之间的点线分割线（代码覆盖背景为 NokiaDashedLineDrawable 点阵） -->
    <View
        android:id="@+id/shortcutDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/shortcutBar"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp" />

    <!-- 桌面组件区：填充快捷栏下方到便捷开关栏之间的剩余空间，动态渲染用户添加的组件 -->
    <LinearLayout
        android:id="@+id/notificationArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/shortcutDivider"
        android:layout_above="@id/quickToggleDivider"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp" />

    <!-- 便捷开关栏上方的点线分割线 -->
    <View
        android:id="@+id/quickToggleDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/quickToggleScroll"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp" />

    <!-- 便捷开关栏：固定位于桌面组件区下方，支持自适应均匀分布与多项横向滚动 -->
    <HorizontalScrollView
        android:id="@+id/quickToggleScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="0dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quickToggleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </HorizontalScrollView>

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="10dp"
        android:alpha="0.15"
        app:srcCompat="@drawable/deco_rings" />
</RelativeLayout>
