<?xml version="1.0" encoding="utf-8"?>
<!-- 高级设置：顶部提示 + 纵向列表（mini_shizuku / 电源键拦截） -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 顶部提示：本页功能均依赖 mini_shizuku 服务 -->
    <TextView
        android:id="@+id/advancedNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:text="本页面的功能均需要mini_shizuku支持"
        android:textColor="#9FB3D1"
        android:textSize="11sp" />

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/advancedNotice"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/settingsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </ScrollView>
</RelativeLayout>
