<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 标题栏（蓝渐变，复用诺基亚风格） -->
    <LinearLayout
        android:id="@+id/uninstall_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nokia_dialog_title_bar_height"
        android:background="@drawable/bg_nokia_softkey"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/uninstall_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="卸载"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/nokia_dialog_title_text"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 内容区 -->
    <LinearLayout
        android:id="@+id/uninstall_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#102040"
        android:gravity="center"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/uninstall_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/nokia_dialog_title_text" />
    </LinearLayout>

    <!-- 底部软键栏：左=卸载（确认），右=取消。两键宽度贴合文字，中间 spacer 撑开 -->
    <LinearLayout
        android:id="@+id/uninstall_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nokia_dialog_title_bar_height"
        android:background="@drawable/bg_nokia_softkey"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/softLeft"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|start"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:text="卸载"
            android:textColor="#64b5f6"
            android:textSize="@dimen/nokia_dialog_body_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/softRight"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:text="取消"
            android:textColor="#64b5f6"
            android:textSize="@dimen/nokia_dialog_body_text" />
    </LinearLayout>
</LinearLayout>
