<?xml version="1.0" encoding="utf-8"?>
<!-- Keydroidx 触屏模式虚拟按键面板（API 19 兼容，一体化四瓣无缝导航环方案 A） -->
<ru.playsoftware.j2meloader.nokia.KeydroidxVirtualKeypadView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/virtualKeypadView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#12151b"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="5dp">

    <!-- 机身顶部分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:background="#2d3748" />

    <!-- 1. 功能与导航岛 (Navigation Island) - 100% 空间利用率无死角无缝全覆盖导航环 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <!-- 左翼：LSK + CALL -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- LSK 左软键（最常用按键之一） -->
            <FrameLayout
                android:id="@+id/btn_key_lsk"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keydroidx_virtual_key"
                android:clickable="true"
                android:focusable="false">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="LSK"
                    android:textColor="#f0f4f8"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp" />

            <!-- CALL 拨号/接听键（正统诺基亚绿色倾斜听筒） -->
            <FrameLayout
                android:id="@+id/btn_key_call"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keydroidx_virtual_key_call"
                android:clickable="true"
                android:focusable="false">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_keydroidx_phone" />
            </FrameLayout>
        </LinearLayout>

        <!-- 中央 5 向 D-Pad 一体化四瓣无缝导航环 (方案 A：100% 空间利用率，对角线几何切割，无任何死角) -->
        <ru.playsoftware.j2meloader.nokia.KeydroidxNaviWheelView
            android:id="@+id/naviWheelView"
            android:layout_width="196dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp" />

        <!-- 右翼：RSK + END -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- RSK 右软键（最常用按键之一） -->
            <FrameLayout
                android:id="@+id/btn_key_rsk"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keydroidx_virtual_key"
                android:clickable="true"
                android:focusable="false">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="RSK"
                    android:textColor="#f0f4f8"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp" />

            <!-- END 挂机/Home键（正统诺基亚红色扣断听筒） -->
            <FrameLayout
                android:id="@+id/btn_key_end"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keydroidx_virtual_key_end"
                android:clickable="true"
                android:focusable="false">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_keydroidx_endcall" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 2. 经典九宫格 T9 数字键区 (紧凑压缩垂直空间至每行 28dp，间距 2.5dp) -->
    <!-- 第 1 行: 1, 2, 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:layout_marginBottom="2.5dp">

        <LinearLayout
            android:id="@+id/btn_key_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="2.5dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#f0f4f8"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=".,?"
                android:textColor="#8e9cae"
                android:textSize="7sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2.5dp"
            android:layout_marginRight="2.5dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="#f0f4f8"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABC"
                android:textColor="#8e9cae"
                android:textSize="7sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2.5dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#f0f4f8"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEF"
                android:textColor="#8e9cae"
                android:textSize="7sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 2 行: 4, 5, 6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:layout_marginBottom="2.5dp">

        <LinearLayout
            android:id="@+id/btn_key_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="2.5dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="#f0f4f8"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GHI"
                android:textColor="#8e9cae"
                android:textSize="7sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2.5dp"
            android:layout_marginRight="2.5dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="#f0f4f8"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JKL"
                android:textColor="#8e9cae"
                android:textSize="7sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2.5dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6"
                android:textColor="#f0f4f8"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MNO"
                android:textColor="#8e9cae"
                android:textSize="7sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 3 行: 7, 8, 9 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:layout_marginBottom="2.5dp">

        <LinearLayout
            android:id="@+id/btn_key_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="2.5dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7"
                android:textColor="#f0f4f8"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PQRS"
                android:textColor="#8e9cae"
                android:textSize="7sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2.5dp"
            android:layout_marginRight="2.5dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8"
                android:textColor="#f0f4f8"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TUV"
                android:textColor="#8e9cae"
                android:textSize="7sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2.5dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9"
                android:textColor="#f0f4f8"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WXYZ"
                android:textColor="#8e9cae"
                android:textSize="7sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 4 行: *, 0, # -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_key_star"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="2.5dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="*"
                android:textColor="#f0f4f8"
                android:textSize="15sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textColor="#8e9cae"
                android:textSize="7sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2.5dp"
            android:layout_marginRight="2.5dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#f0f4f8"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="空格"
                android:textColor="#8e9cae"
                android:textSize="7sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_pound"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2.5dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#"
                android:textColor="#f0f4f8"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔕"
                android:textColor="#8e9cae"
                android:textSize="7sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

</ru.playsoftware.j2meloader.nokia.KeydroidxVirtualKeypadView>
