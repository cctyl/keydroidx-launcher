<?xml version="1.0" encoding="utf-8"?>
<!-- Keydroidx 触屏模式虚拟按键面板（API 19 兼容，对齐 FEATURE_PHONE_UI_SPEC） -->
<ru.playsoftware.j2meloader.nokia.KeydroidxVirtualKeypadView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/virtualKeypadView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#12151b"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <!-- 机身顶部分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="#2d3748" />

    <!-- 1. 功能与导航岛 (Navigation Island) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <!-- 左翼：LSK + CALL -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- LSK 左软键 -->
            <FrameLayout
                android:id="@+id/btn_key_lsk"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keydroidx_virtual_key"
                android:clickable="true"
                android:focusable="false">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="LSK"
                    android:textColor="#f0f4f8"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <!-- CALL 拨号/接听键 -->
            <FrameLayout
                android:id="@+id/btn_key_call"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keydroidx_virtual_key_call"
                android:clickable="true"
                android:focusable="false">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_keydroidx_phone" />
            </FrameLayout>
        </LinearLayout>

        <!-- 中央 5 向 D-Pad 导航群 -->
        <RelativeLayout
            android:layout_width="126dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_keydroidx_virtual_dpad_ring">

            <!-- UP 方向键 -->
            <FrameLayout
                android:id="@+id/btn_key_up"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:clickable="true"
                android:focusable="false">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="▲"
                    android:textColor="#cbd5e1"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- DOWN 方向键 -->
            <FrameLayout
                android:id="@+id/btn_key_down"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:clickable="true"
                android:focusable="false">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="▼"
                    android:textColor="#cbd5e1"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- LEFT 方向键 -->
            <FrameLayout
                android:id="@+id/btn_key_left"
                android:layout_width="28dp"
                android:layout_height="40dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="false">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="◀"
                    android:textColor="#cbd5e1"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- RIGHT 方向键 -->
            <FrameLayout
                android:id="@+id/btn_key_right"
                android:layout_width="28dp"
                android:layout_height="40dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="false">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="▶"
                    android:textColor="#cbd5e1"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- CENTER 确认键 (OK) -->
            <FrameLayout
                android:id="@+id/btn_key_center"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_keydroidx_virtual_key_center"
                android:clickable="true"
                android:focusable="false">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="OK"
                    android:textColor="#ffffff"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

        </RelativeLayout>

        <!-- 右翼：RSK + END -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- RSK 右软键 -->
            <FrameLayout
                android:id="@+id/btn_key_rsk"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keydroidx_virtual_key"
                android:clickable="true"
                android:focusable="false">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="RSK"
                    android:textColor="#f0f4f8"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <!-- END 挂机/电源键 -->
            <FrameLayout
                android:id="@+id/btn_key_end"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keydroidx_virtual_key_end"
                android:clickable="true"
                android:focusable="false">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_keydroidx_endcall" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 2. 经典九宫格 T9 数字键区 (3×4 Keypad Grid) -->
    <!-- 第 1 行: 1, 2, 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="41dp"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp">

        <LinearLayout
            android:id="@+id/btn_key_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="3dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#f0f4f8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=".,?"
                android:textColor="#8e9cae"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="#f0f4f8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABC"
                android:textColor="#8e9cae"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#f0f4f8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEF"
                android:textColor="#8e9cae"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 2 行: 4, 5, 6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="41dp"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp">

        <LinearLayout
            android:id="@+id/btn_key_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="3dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="#f0f4f8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GHI"
                android:textColor="#8e9cae"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="#f0f4f8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JKL·"
                android:textColor="#8e9cae"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6"
                android:textColor="#f0f4f8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MNO"
                android:textColor="#8e9cae"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 3 行: 7, 8, 9 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="41dp"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp">

        <LinearLayout
            android:id="@+id/btn_key_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="3dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7"
                android:textColor="#f0f4f8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PQRS"
                android:textColor="#8e9cae"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8"
                android:textColor="#f0f4f8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TUV"
                android:textColor="#8e9cae"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9"
                android:textColor="#f0f4f8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WXYZ"
                android:textColor="#8e9cae"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 4 行: *, 0, # -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="41dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_key_star"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="3dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="*"
                android:textColor="#f0f4f8"
                android:textSize="18sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#8e9cae"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#f0f4f8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="空格"
                android:textColor="#8e9cae"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_key_pound"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:background="@drawable/bg_keydroidx_virtual_key"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#"
                android:textColor="#f0f4f8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔕"
                android:textColor="#8e9cae"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

</ru.playsoftware.j2meloader.nokia.KeydroidxVirtualKeypadView>
