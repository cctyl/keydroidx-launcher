<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面设置 → 外观与显示 → 自定义字体缩放输入页（NokiaCustomFontScaleFragment）。
     标题说明 + 预估字号提示 + 输入框 + 确认说明。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <TextView
        android:id="@+id/tvCustomScaleTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:text="自定义字体倍率"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCustomScaleHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:text="请输入字体倍率（例如 1.0 代表 100%，1.5 代表 150%，范围 0.5 ~ 3.0）："
        android:textColor="#AAAAAA"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/etCustomScale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_nokia_searchbox"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="例如 1.5"
        android:imeOptions="actionDone"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#88FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvPreviewText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="12dp"
        android:text="预览效果：KeydroidX 原键复古像素字体"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

</LinearLayout>
