<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面组件设置 → 添加Activity快捷 → 步骤2：选择Activity。
     标题 + 纵向列表容器 + 页码 + 空状态提示。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- 标题行：左标题，右页码 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvActivityPickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="选择Activity"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActivityPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="4dp"
            android:text="1/1"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 列表容器：行由代码动态构建 -->
    <ScrollView
        android:id="@+id/activityScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/activityListLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp" />
    </ScrollView>

    <!-- 空状态提示：动态显示 -->
    <TextView
        android:id="@+id/tvActivityEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:paddingTop="20dp"
        android:text="该应用没有可用的Activity"
        android:textColor="#AAAAAA"
        android:textSize="12sp" />
</LinearLayout>
