<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面组件设置选项菜单弹窗（S2 选项菜单 / S3 删除子菜单共用）。
     视觉与「功能表→应用程序→选中JAR的选项菜单」一致：底部锚定，
     标题栏 + 选项列表（代码构建）+ 自带底部软键栏（只显示文字，无高亮）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ========== 标题栏 ========== -->
    <LinearLayout
        android:id="@+id/widgetOptionsTitleBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nokia_dialog_title_bar_height"
        android:background="@drawable/bg_nokia_softkey"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/widgetOptionsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/nokia_dialog_title_text"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ========== 选项列表 ========== -->
    <LinearLayout
        android:id="@+id/widgetOptionsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0a0f1d"
        android:orientation="vertical" />

    <!-- ========== 底部软键栏 ========== -->
    <!-- 规范：软键栏只显示文字标签，无高亮/焦点逻辑 -->
    <LinearLayout
        android:id="@+id/widgetOptionsBottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nokia_dialog_title_bar_height"
        android:background="@drawable/bg_nokia_softkey"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|start"
            android:paddingHorizontal="8dp"
            android:text="选择"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/nokia_dialog_body_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:paddingHorizontal="8dp"
            android:text="返回"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/nokia_dialog_body_text" />
    </LinearLayout>
</LinearLayout>
