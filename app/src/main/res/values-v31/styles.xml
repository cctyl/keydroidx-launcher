<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ 强制 SplashScreen：黑底 + 透明图标，
         不显示桌面 launcher 图标，避免启动 jar 时像“桌面又重启了一次”。 -->
    <style name="Theme.MicroActivity" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
    </style>

</resources>
